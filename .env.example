# PostgreSQL (destino de carga das tabelas)
PG_HOST=seu_host_aqui
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=troque_aqui
PG_SCHEMA=macroeconomia

# Janela de histórico extraída a cada execução (dias)
ETL_DIAS_HISTORICO=400

# Pasta temporária da camada local de parquet
ETL_OUTPUT_DIR=./dados_processados
